{
  "name": "nms-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PoC de universo procedural seamless (estilo No Man's Sky) com Three.js + Web Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/extract-assets.ps1",
    "deploy": "npm run build && npm run zip",
    "zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/zip.ps1",
    "mp": "node server/mp-server.js",
    "start": "node server/mp-server.js"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "mysql2": "^3.23.3",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
